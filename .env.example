# Copy this file to .env and replace every value marked "change-me".
# Never commit .env.

# Application security
JWT_SECRET=change-me-use-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000

# Frontend
REACT_APP_API_URL=http://localhost:8000

# MySQL
MYSQL_DATABASE=allegrocode
MYSQL_USER=allegrocode
MYSQL_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Yandex Cloud (required for the assistant and MIDI simplification)
YANDEX_FOLDER_ID=change-me
YANDEX_API_KEY=change-me

# Optional integrations
GEMINI_API_KEY=
STABILITY_API_KEY=

